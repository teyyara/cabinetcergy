---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
const practitioners = [
  { name: "Edith Fautras", rows: [["Premier entretien", "50 €"], ["Séance de 30 minutes", "38,86 €"], ["Séance de 45 minutes", "55 €"], ["Séance de 60 minutes", "65 €"], ["Déplacement en réunion", "60 €"], ["Guidance parentale", "60 €"], ["Supervision des AESH à l’école", "150 € / 3 heures à l’école (sous réserve d’autorisation par l’inspecteur académique)"]] },
  { name: "Jarod Florance", rows: [["Premier entretien", "50 €"], ["Séance de 30 minutes", "38,86 €"], ["Séance de 45 minutes", "55 €"], ["Séance de 60 minutes", "65 €"], ["Déplacement en réunion", "60 €"]] },
  { name: "Bouhar Oubeidi", rows: [["Premier entretien", "50 €"], ["Séance de 30 minutes", "38,86 €"], ["Séance de 45 minutes", "50 €"], ["Séance de 60 minutes", "60 €"], ["Déplacement en réunion", "60 €"], ["Guidance parentale", "60 €"]] },
];
const groups = [
  {name:"Maternelle", frequency:"2 × 1 h 30 / semaine", schedule:"Lundi et mercredi matin, 9 h 30 – 11 h"},
  {name:"Indigo", frequency:"2 × 1 h 30 / semaine", schedule:"Lundi après-midi, 15 h 30 – 17 h ; mercredi matin, 11 h – 12 h 30"},
  {name:"Turquoise", frequency:"2 × 1 h 30 / semaine", schedule:"Lundi, 13 h 15 – 14 h 45 ; mercredi après-midi, 13 h 30 – 15 h"},
  {name:"Azur", frequency:"1 h 30 / semaine", schedule:"Mercredi soir, 17 h – 18 h 30"},
];
---
<BaseLayout title="Prestations et tarifs | Cabinet des Hérons — Cergy" description="Tarifs publiés pour l’année scolaire 2026–2027 et informations concernant les accompagnements individuels et de groupe." currentPath="/prestations/">
  <PageIntro eyebrow="Informations pratiques" title="Prestations & tarifs" description="Les montants et horaires ci-dessous reprennent les informations publiées par le cabinet pour l’année scolaire 2026–2027. Veuillez confirmer les informations en vigueur auprès du cabinet." />
  <section class="section"><div class="container">
    <div class="notice-card"><strong>À propos des tarifs</strong><p>Selon les informations publiées par le cabinet, les tarifs comprennent la prestation, le matériel, la préparation du soin et le rangement de la salle. Le cabinet indique également que les soins libéraux sont à la charge des familles et ne sont pas pris en charge par la carte Vitale. Les conditions de remboursement n’ont pas été vérifiées indépendamment et doivent être confirmées auprès des organismes concernés.</p></div>
    {practitioners.map((person) => <section class="pricing-block"><h2>{person.name}</h2><div class="table-wrap" role="region" tabindex="0" aria-label={`Tarifs : ${person.name}`}><table><caption class="sr-only">Tarifs affichés pour les prestations de {person.name}</caption><thead><tr><th scope="col">Prestation</th><th scope="col">Tarif affiché</th></tr></thead><tbody>{person.rows.map(([service, price]) => <tr><td>{service}</td><td><strong>{price}</strong></td></tr>)}</tbody></table></div></section>)}
    <section class="pricing-block"><h2>Accompagnements en groupe</h2><p>Le tarif publié pour les groupes est de 35 € par séance de 1 h 30, dans le cadre d’un forfait annuel mensualisé sur 11 ou 12 mois. Le montant final est établi sur devis en fonction du nombre de séances et de la fréquence.</p>
      <div class="schedule-grid">{groups.map((group) => <article class="schedule-card"><div class="schedule-card-top"><h3>{group.name}</h3><span class="schedule-badge">2026–2027</span></div><p class="schedule-time">{group.frequency}</p><p>{group.schedule}</p><p class="small-print">Tarif sur devis</p></article>)}</div>
      <p class="price-note">Les groupes sont proposés par les professionnels en fonction des besoins de l’enfant ; les parents ne choisissent pas directement le groupe.</p><a class="text-link" href="/prise-en-charge-de-groupe/">En savoir plus sur les groupes</a>
    </section>
    <div class="feature-band"><div><p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>Informations complémentaires</p><h2>Une question sur les modalités ?</h2><p>Le cabinet invite les familles à le contacter pour les questions concernant les tarifs et les modalités de prise en charge.</p></div><div class="feature-band-aside"><p>Contact direct</p><a class="button button-light" href="mailto:edith.fautras@gmail.com">Écrire au cabinet ↗</a><p><a href="tel:+33781243098">07 81 24 30 98</a></p></div></div>
  </div></section>
</BaseLayout>
