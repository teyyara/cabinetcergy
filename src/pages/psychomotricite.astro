---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
const domains = [
  ["Motricité globale", "Développement des capacités motrices générales, de l’équilibre, de la coordination et de l’aisance corporelle dans les activités du quotidien."],
  ["Motricité fine", "Travail de la précision des gestes, de la manipulation d’objets et des compétences nécessaires aux activités scolaires et de la vie quotidienne."],
  ["Graphisme", "Accompagnement des compétences graphiques participant progressivement à l’acquisition de l’écriture et à l’amélioration du geste graphique."],
  ["Repérage dans l’espace", "Développement de la compréhension et de l’organisation spatiale afin de mieux se situer dans son environnement."],
  ["Repérage dans le temps", "Accompagnement des notions temporelles, de l’organisation des activités et de la structuration du temps au quotidien."],
  ["Schéma corporel", "Meilleure connaissance et représentation de son corps afin de favoriser la confiance en soi et les apprentissages."],
  ["Coordination et planification motrice", "Développement des capacités à organiser et réaliser des actions motrices adaptées aux différentes situations."],
];
---
<BaseLayout title="Psychomotricité | Cabinet des Hérons — Cergy" description="Présentation de l’accompagnement en psychomotricité proposé par le Cabinet des Hérons à Cergy." currentPath="/psychomotricite/">
  <PageIntro eyebrow="Nos accompagnements" title="Psychomotricité" description="Accompagnement individualisé — le site source indique qu’une ordonnance médicale est nécessaire pour les soins en psychomotricité." />
  <section class="section"><div class="container editorial-grid"><div><p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>Corps, émotions & environnement</p><h2>Soutenir le développement global de l’enfant.</h2></div><div class="prose"><p>La psychomotricité s’intéresse aux liens entre le corps, les émotions, les capacités cognitives et les relations avec l’environnement.</p><p>L’accompagnement psychomoteur vise à soutenir le développement global de l’enfant ou de l’adolescent en prenant en compte ses besoins spécifiques et ses capacités.</p><p>Chaque prise en charge est individualisée et adaptée aux objectifs définis avec la famille.</p></div></div></section>
  <section class="section section-soft"><div class="container"><p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>Domaines travaillés</p><h2>Des compétences utiles au quotidien.</h2><div class="service-domain-grid">{domains.map(([title, description]) => <article class="domain-card"><h3>{title}</h3><p>{description}</p></article>)}</div></div></section>
  <section class="section"><div class="container feature-band"><div><p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>Une approche individualisée</p><h2>Chaque enfant évolue à son propre rythme.</h2><p>Les séances sont adaptées à ses besoins, à ses objectifs et à son développement afin de favoriser son épanouissement et son autonomie.</p></div><div class="feature-band-aside"><p>Vous souhaitez échanger sur les modalités de prise en charge ?</p><a class="button button-light" href="/liste-attente/">Accéder à la liste d’attente ↗</a></div></div></section>
</BaseLayout>
