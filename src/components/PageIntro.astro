---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  compact?: boolean;
}
const { eyebrow, title, description, compact = false } = Astro.props;
---
<section class:list={["page-intro", compact ? "page-intro-compact" : ""]}>
  <div class="container page-intro-inner">
    <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>{eyebrow}</p>
    <h1>{title}</h1>
    {description && <p class="page-intro-description">{description}</p>}
    <span class="intro-ornament" aria-hidden="true"></span>
  </div>
</section>
