---
interface Props {
  currentPath?: string;
}
const { currentPath = "/" } = Astro.props;

const links = [
  { label: "Le cabinet", href: "/le-cabinet/" },
  { label: "L’équipe", href: "/equipe/" },
  { label: "Les services", href: "/#services" },
  { label: "Tarifs & groupes", href: "/prestations/" },
  { label: "Accès", href: "/acces/" },
  { label: "Ressources", href: "/ressources-utiles/" },
];
const logoUrl = "/images/cabinet-des-herons-logo.webp";
const isCurrentPage = (href: string) => currentPath === href;
const isCurrentSection = (href: string) =>
  currentPath === "/prise-en-charge-de-groupe/" && href === "/prestations/";
---
<header class="site-header">
  <div class="header-inner container">
    <a class="brand" href="/" aria-label="Cabinet des Hérons — accueil">
      <img
        class="brand-logo"
        src={logoUrl}
        width="62"
        height="62"
        alt=""
        decoding="async"
        fetchpriority="high"
      />
      <span class="brand-copy">
        <strong>Cabinet des Hérons</strong>
        <span>Cergy · Psychomotricité & psychoéducation</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Navigation principale">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={["nav-link", isCurrentPage(link.href) || isCurrentSection(link.href) ? "is-active" : ""]}
          aria-current={isCurrentPage(link.href) ? "page" : isCurrentSection(link.href) ? "location" : undefined}
        >{link.label}</a>
      ))}
    </nav>

    <a class="button button-small header-cta" href="/liste-attente/">
      Liste d’attente <span aria-hidden="true">↗</span>
    </a>

    <details class="mobile-menu">
      <summary aria-label="Ouvrir le menu de navigation">
        <span class="menu-lines" aria-hidden="true"><i></i><i></i><i></i></span>
      </summary>
      <nav aria-label="Navigation mobile">
        {links.map((link) => (
          <a href={link.href} class:list={[isCurrentPage(link.href) || isCurrentSection(link.href) ? "is-active" : ""]} aria-current={isCurrentPage(link.href) ? "page" : isCurrentSection(link.href) ? "location" : undefined}>{link.label}</a>
        ))}
        <a class="mobile-menu-cta" href="/liste-attente/">Accéder à la liste d’attente ↗</a>
      </nav>
    </details>
  </div>
</header>


<script>
  const mobileMenus = document.querySelectorAll<HTMLDetailsElement>(".mobile-menu");

  mobileMenus.forEach((menu) => {
    const summary = menu.querySelector("summary");
    const syncMenuLabel = () => {
      summary?.setAttribute(
        "aria-label",
        menu.open ? "Fermer le menu de navigation" : "Ouvrir le menu de navigation",
      );
    };

    syncMenuLabel();
    menu.addEventListener("toggle", syncMenuLabel);

    menu.addEventListener("keydown", (event: KeyboardEvent) => {
      if (event.key !== "Escape" || !menu.open) return;
      event.preventDefault();
      menu.open = false;
      summary?.focus();
    });

    menu.querySelectorAll("nav a").forEach((link) => {
      link.addEventListener("click", () => {
        menu.open = false;
      });
    });
  });

  // The Services item is an in-page link, so keep its current-location state in
  // sync with the section the visitor is actually reading.
  const serviceSection = document.querySelector<HTMLElement>("#services");
  const serviceLinks = document.querySelectorAll<HTMLAnchorElement>(
    '.desktop-nav a[href="/#services"], .mobile-menu nav a[href="/#services"]',
  );

  const updateServiceNavigation = (isCurrent: boolean) => {
    serviceLinks.forEach((link) => {
      link.classList.toggle("is-active", isCurrent);
      if (isCurrent) {
        link.setAttribute("aria-current", "location");
      } else if (link.getAttribute("aria-current") === "location") {
        link.removeAttribute("aria-current");
      }
    });
  };

  if (serviceSection && serviceLinks.length > 0 && "IntersectionObserver" in window) {
    const serviceSectionObserver = new IntersectionObserver((entries) => {
      const entry = entries[0];
      if (entry) updateServiceNavigation(entry.isIntersecting);
    }, {
      rootMargin: "-96px 0px -55% 0px",
      threshold: 0,
    });

    serviceSectionObserver.observe(serviceSection);
  }

</script>
